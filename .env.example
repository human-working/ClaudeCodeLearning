# Copy to .env and change the values.
# Shared by auth (signs tokens) and posts (verifies tokens). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=60

AUTH_DB_PASSWORD=auth
POSTS_DB_PASSWORD=posts

GATEWAY_PORT=8080
