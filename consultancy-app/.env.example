# Copy to .env and fill in. .env is gitignored: never commit real secrets.

# REQUIRED. At least 32 random bytes, shared by auth (signs) and matcher (verifies).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Claude API key (server-side only, never sent to the browser).
# Leave empty to run the matcher in clearly-labelled demo/mock mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# auto = Claude if a key is set, else mock | claude = require a key | mock = never call Claude
MATCHER_MODE=auto

# Browser origins allowed to call the API (comma-separated, exact match).
ALLOWED_ORIGINS=http://localhost:8080
APP_PORT=8080

# Session cookie: Secure is on by default. Browsers treat http://localhost as secure,
# so this works locally; only set false for non-localhost plain-HTTP testing.
COOKIE_SECURE=true
JWT_TTL_MINUTES=15
BCRYPT_ROUNDS=12

CURRENCY=USD
LOG_LEVEL=INFO
